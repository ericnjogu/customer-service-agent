#!/usr/bin/env bash
set -euo pipefail

export BORG_REPO="ssh://{{ storage_box_user }}@{{ storage_box_host }}:23/./ristoh-production/cluster-state"
export BORG_RSH="ssh -i /root/.ssh/storage-box -o BatchMode=yes -o StrictHostKeyChecking=yes"
export BORG_PASSPHRASE={{ borg_passphrase | quote }}

borg create --stats --compression zstd,3 \
  "::{hostname}-{now:%Y-%m-%dT%H:%M:%SZ}" \
  /var/lib/rancher/k3s/server/db/snapshots \
  /var/lib/rancher/k3s/server/cred \
  /etc/rancher/k3s
borg prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6
borg compact
